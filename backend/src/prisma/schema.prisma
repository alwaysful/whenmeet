// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 사용자 모델
model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  name          String
  profileImage  String?
  provider      String   // 'GOOGLE'
  providerId    String   // OAuth provider의 사용자 ID
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime? // 소프트 삭제

  // Relations
  rooms              RoomMember[]      @relation("UserRooms")
  datePreferences    DatePreference[]  @relation("UserDatePreferences")

  @@unique([provider, providerId])
  @@index([email])
  @@index([provider, providerId])
  @@map("users")
}

// 방 모델
model Room {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  inviteCode  String   @unique // 8자리 초대코드
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  members         RoomMember[]      @relation("RoomMembers")
  datePreferences DatePreference[]  @relation("RoomDatePreferences")

  @@index([inviteCode])
  @@map("rooms")
}

// 방 멤버 (User와 Room의 다대다 관계)
model RoomMember {
  id       Int      @id @default(autoincrement())
  userId   Int
  roomId   Int
  joinedAt DateTime @default(now())

  // Relations
  user User @relation("UserRooms", fields: [userId], references: [id], onDelete: Cascade)
  room Room @relation("RoomMembers", fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([userId, roomId])
  @@index([userId])
  @@index([roomId])
  @@map("room_members")
}

// 날짜 선호도 모델
model DatePreference {
  id         Int      @id @default(autoincrement())
  userId     Int
  roomId     Int
  date       DateTime @db.Date // 날짜만 저장
  preference String   // 'GOOD', 'NEUTRAL', 'BAD'
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  user User @relation("UserDatePreferences", fields: [userId], references: [id], onDelete: Cascade)
  room Room @relation("RoomDatePreferences", fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([userId, roomId, date])
  @@index([roomId, date])
  @@index([userId, roomId])
  @@map("date_preferences")
}

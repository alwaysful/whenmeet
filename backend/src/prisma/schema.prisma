generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Provider {
  GOOGLE
}

enum Preference {
  GOOD
  NEUTRAL
  BAD
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  name         String
  profileImage String?
  provider     Provider
  providerId   String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  rooms           RoomMember[]     @relation("UserRooms")
  datePreferences DatePreference[] @relation("UserDatePreferences")

  @@unique([provider, providerId])
  @@index([email])
  @@index([provider, providerId])
  @@map("users")
}

model Room {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  inviteCode  String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members         RoomMember[]     @relation("RoomMembers")
  datePreferences DatePreference[] @relation("RoomDatePreferences")

  @@index([inviteCode])
  @@map("rooms")
}

model RoomMember {
  id       Int      @id @default(autoincrement())
  userId   Int
  roomId   Int
  joinedAt DateTime @default(now())

  user User @relation("UserRooms", fields: [userId], references: [id], onDelete: Cascade)
  room Room @relation("RoomMembers", fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([userId, roomId])
  @@index([userId])
  @@index([roomId])
  @@map("room_members")
}

model DatePreference {
  id         Int        @id @default(autoincrement())
  userId     Int
  roomId     Int
  date       DateTime   @db.Date
  preference Preference
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user User @relation("UserDatePreferences", fields: [userId], references: [id], onDelete: Cascade)
  room Room @relation("RoomDatePreferences", fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([userId, roomId, date])
  @@index([roomId, date])
  @@index([userId, roomId])
  @@map("date_preferences")
}
